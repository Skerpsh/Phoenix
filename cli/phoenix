#!/usr/bin/env python3
"""Phoenix: run without arguments to open the menu."""

import os
import shutil
import sys
from pathlib import Path

if sys.version_info < (3, 11):  # noqa: UP036 (runs before anything newer is imported)
    for candidate in ("python3.13", "python3.12", "python3.11"):
        if shutil.which(candidate):
            os.execvp(candidate, [candidate, *sys.argv])
    sys.exit("Phoenix needs Python 3.11 or newer (Ubuntu 22.04: sudo apt install python3.11).")

CLI = Path(__file__).resolve().parent
sys.path[:0] = [str(CLI), str(CLI.parent / "server")]

from phx.main import main  # noqa: E402

if __name__ == "__main__":
    main()
