#!/usr/bin/env python3
"""Phoenix CLI — prepare, encrypt and upload packages; set up and manage the server.

Files are encrypted on this PC with the server's public key; plaintext never leaves your machine.
With the vault enabled, packages on this PC are also kept encrypted (gocryptfs) when you're not editing them.
"""

import argparse
import contextlib
import getpass
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "server"))
from phoenix import durations  # noqa: E402  (stdlib-only module shared with the server)

CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "phoenix" / "config.json"
STAGING = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "phoenix" / "staging"
VAULT = ROOT / "vault"

RECIPIENT_FILE = "recipient.toml"
ACCOUNT_TOML = "_account.toml"
ACCOUNT_BLOB = "_account.json.age"
TEXT_SUFFIXES = {".txt", ".md"}
VOICE_SUFFIXES = {".ogg", ".oga", ".opus"}
ROUND_SUFFIX = ".round.mp4"
TRIGGERS = ("silence", "panic")
TG_FILE_LIMIT = 2000 * 1024 * 1024  # Telegram limit for non-Premium accounts
HORIZON = 364 * 86400  # Telegram keeps scheduled messages for up to a year
TEMPLATE_MARK = "PHOENIX-TEMPLATE"

RECIPIENT_TEMPLATE = """\
# Who receives this package.
name = "{name}"

# Telegram: "@username", "+380XXXXXXXXX" (must be in your contacts) or a numeric user id.
telegram = "@username"

# --- Optional -------------------------------------------------------------------
# When to send: "silence" (you stopped checking in) and/or "panic" (panic button).
# on = ["silence", "panic"]

# Wait this long after the trigger before sending anything (30m, 12h, 3d, 2w, 1y).
# delay = "3d"

# If {name} hasn't read the package after `backup_after`, send it to someone else.
# backup = "@someone_else"
# backup_after = "7d"
# backup_note = "This was meant for ..., but they could not be reached."
"""

LETTER_TEMPLATE = f"""\
{TEMPLATE_MARK} — delete this line, otherwise `phoenix push` refuses to upload.

Write your message here.

How files in this folder are sent (alphabetical order by path):
  *.txt, *.md          → text messages
  *.ogg / *.opus       → voice messages
  *.round.mp4          → round video messages (square video, up to 60 s)
  anything else        → files, original quality
Folders named like "@+1y" or "@2034-05-12" hold items sent later:
  @+1y                 → 1 year after this package starts
  @2034-05-12          → on that date at 09:00 (@2034-05-12T18:30 for a specific time)
"""

ACCOUNT_TEMPLATE = f"""\
# {TEMPLATE_MARK} — delete this line when you're done.
# What Phoenix does with your Telegram account after it is triggered.

# Which triggers run these actions: "silence" and/or "panic".
on = ["silence"]

# Sent once to each person who messages you in a private chat (not to your recipients).
autoreply = \"\"\"
This is an automatic message. I can no longer answer here.
\"\"\"

# Your new profile bio (up to 70 characters; restored if you /abort).
# about = "..."

# Messages to groups, channels or people. Repeat the block for more.
# [[post]]
# chat = "@some_group"
# text = "..."
# delay = "1d"
"""


def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def need(*tools: str) -> None:
    for tool in tools:
        if not shutil.which(tool):
            die(f"'{tool}' is not installed (Arch: sudo pacman -S {tool})")


def load_config() -> dict:
    if not CONFIG_PATH.exists():
        die("not initialized yet, run: phoenix init --server root@SERVER_IP")
    return json.loads(CONFIG_PATH.read_text())


def save_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2))
    CONFIG_PATH.chmod(0o600)


def ssh(cfg: dict, command: str, *, tty: bool = False, capture: bool = False, input: str | None = None):
    remote = f"cd {shlex.quote(cfg['remote_dir'])} && {command}"
    args = ["ssh", *(["-t"] if tty else []), cfg["server"], remote]
    return subprocess.run(args, text=True, capture_output=capture, input=input)


def sh(*args: str) -> None:
    if subprocess.run(args).returncode:
        die(f"command failed: {' '.join(args)}")


def h16(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()[:16]


def human(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def ask_yes(question: str, default: bool = True) -> bool:
    answer = input(f"{question} [{'Y/n' if default else 'y/N'}] ").strip().lower()
    return default if not answer else answer.startswith("y")


# ---------------------------------------------------------------------------- vault
def vault_enabled() -> bool:
    return (VAULT / "gocryptfs.conf").exists()


def mountpoint() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "phoenix-packages"


def unmount(mp: Path) -> bool:
    tool = shutil.which("fusermount3") or shutil.which("fusermount") or "fusermount3"
    if subprocess.run([tool, "-u", str(mp)]).returncode:
        print(f"⚠️ Could not lock the vault: close every window/terminal using {mp}, then run: phoenix lock")
        return False
    mp.rmdir()
    return True


@contextlib.contextmanager
def packages_root(cfg: dict):
    """Yields the folder with plaintext packages; unlocks (and re-locks) the vault if it's enabled."""
    if not vault_enabled():
        yield Path(cfg["packages_dir"])
        return
    need("gocryptfs")
    mp = mountpoint()
    if os.path.ismount(mp):  # already unlocked by another `phoenix edit`
        yield mp
        return
    mp.mkdir(mode=0o700, exist_ok=True)
    print("🔐 Vault password:")
    if subprocess.run(["gocryptfs", "-q", str(VAULT), str(mp)]).returncode:
        mp.rmdir()
        die("could not unlock the vault (wrong password?)")
    try:
        yield mp
    finally:
        unmount(mp)


def cmd_vault_init(a) -> None:
    need("gocryptfs")
    cfg = load_config()
    if vault_enabled():
        die(f"the vault already exists: {VAULT}")
    plain = Path(cfg["packages_dir"])
    VAULT.mkdir(parents=True, exist_ok=True)
    print("Choose a vault password. You'll type it every time you edit or push packages.")
    print("gocryptfs then prints a MASTER KEY: write it down on paper — it's the only way back if you forget the password.\n")
    if subprocess.run(["gocryptfs", "-init", str(VAULT)]).returncode:
        shutil.rmtree(VAULT, ignore_errors=True)
        die("gocryptfs -init failed")
    if plain.exists() and any(plain.iterdir()):
        with packages_root(cfg) as mp:
            print(f"Moving {plain} into the vault…")
            shutil.copytree(plain, mp, dirs_exist_ok=True)
        if ask_yes(f"Delete the unencrypted folder {plain} now?"):
            shutil.rmtree(plain)
            print("Deleted. (On an SSD, traces may remain on disk until it's overwritten.)")
    print(f"✅ Vault ready: {VAULT}\nBack up this folder anywhere (USB, cloud) — it's useless without the password.")


def cmd_edit(a) -> None:
    cfg = load_config()
    with packages_root(cfg) as root:
        root.mkdir(parents=True, exist_ok=True)
        print(f"📂 Your packages: {root}")
        subprocess.Popen(["xdg-open", str(root)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("Edit them (new recipient: `phoenix new <name>` in another terminal), then come back here.")
        input("Press Enter when you're done… ")
        if ask_yes("Upload the changes to the server now?"):
            push_from(cfg, root)
    if vault_enabled():
        print("🔒 Vault locked.")


def cmd_lock(a) -> None:
    mp = mountpoint()
    if not os.path.ismount(mp):
        print("The vault is not unlocked.")
    elif unmount(mp):
        print("🔒 Vault locked.")


# --------------------------------------------------------------------- server setup
def cmd_init(a) -> None:
    need("ssh", "rsync")
    cfg = json.loads(CONFIG_PATH.read_text()) if CONFIG_PATH.exists() else {}
    cfg.update(server=a.server, remote_dir=a.remote_dir, packages_dir=str(Path(a.packages).expanduser().resolve()))
    cfg.pop("public_key", None)
    if subprocess.run(["ssh", cfg["server"], "true"]).returncode:
        die(f"cannot connect to {cfg['server']} over SSH")
    save_config(cfg)
    if not vault_enabled():
        Path(cfg["packages_dir"]).mkdir(parents=True, exist_ok=True)
    print(f"Saved {CONFIG_PATH}\nNext: phoenix bootstrap")


def cmd_bootstrap(a) -> None:
    cfg = load_config()
    script = (ROOT / "deploy" / "bootstrap.sh").read_text()
    r = subprocess.run(["ssh", cfg["server"], "bash", "-s", "--", cfg["remote_dir"]], input=script, text=True)
    if r.returncode:
        die("bootstrap failed (see output above)")
    print("Next: phoenix deploy")


def cmd_deploy(a) -> None:
    need("rsync")
    cfg = load_config()
    dest = f"{cfg['server']}:{cfg['remote_dir']}/"
    sh("rsync", "-a", "--delete", "--exclude", "__pycache__", str(ROOT / "server"), dest)
    sh("rsync", "-a", str(ROOT / "docker-compose.yml"), dest)
    if ssh(cfg, "docker compose build -q").returncode:
        die("docker build failed")
    fetch_public_key(cfg)
    if ssh(cfg, "test -s .env").returncode:
        print("Code deployed. Next: phoenix configure")
        return
    if ssh(cfg, "docker compose up -d").returncode:
        die("docker compose up failed")
    print("✅ Deployed and running.")


def fetch_public_key(cfg: dict) -> str:
    r = ssh(cfg, "docker compose run --rm -T phoenix python -m phoenix.keygen", capture=True)
    keys = [line.strip() for line in r.stdout.splitlines() if line.strip().startswith("age1")]
    if r.returncode or not keys:
        die(f"cannot get the server key:\n{r.stderr}")
    if cfg.get("public_key") != keys[-1]:
        cfg["public_key"] = keys[-1]
        save_config(cfg)
        print("Server encryption key saved.")
    return keys[-1]


def cmd_configure(a) -> None:
    cfg = load_config()
    print("Values are stored only on the server, in .env (readable by root only).")
    values = {
        "BOT_TOKEN": getpass.getpass("Bot token from @BotFather (hidden): ").strip(),
        "OWNER_ID": input("Your Telegram user id (from @userinfobot): ").strip(),
        "API_ID": input("api_id from my.telegram.org: ").strip(),
        "API_HASH": getpass.getpass("api_hash from my.telegram.org (hidden): ").strip(),
        "TIMEZONE": input("Your time zone for dated letters [Europe/Kyiv]: ").strip() or "Europe/Kyiv",
        "HEARTBEAT_URL": input("Heartbeat URL from healthchecks.io (optional, Enter to skip): ").strip(),
    }
    for key in ("OWNER_ID", "API_ID"):
        if not values[key].isdigit():
            die(f"{key} must be a number")
    content = "".join(f"{k}={v}\n" for k, v in values.items())
    if ssh(cfg, "umask 077 && cat > .env", input=content).returncode:
        die("cannot write .env on the server")
    print("Saved. Next: phoenix login")


def cmd_login(a) -> None:
    cfg = load_config()
    ssh(
        cfg,
        "docker compose stop && docker compose run --rm phoenix python -m phoenix.login; docker compose up -d",
        tty=True,
    )
    print("Open your bot in Telegram and press Start — it will confirm that Phoenix is armed.")


def cmd_status(a) -> None:
    ssh(load_config(), "docker compose exec -T phoenix python -m phoenix.ctl status")


def cmd_log(a) -> None:
    ssh(load_config(), "docker compose exec -T phoenix python -m phoenix.ctl log")


